<% layout("/layouts/boilerplate") %>
<div class="row justify-content-center py-4">
        <div class="col-12 col-md-10 col-lg-8">
            <h3 class="mb-4 mt-4"><b><%= listingdata.title %></b></h3>

            <div class="mb-4">
                <div class="show-image-wrapper">
                    <img src="<%= listingdata.image.url %>" class="show-img" alt="<%= listingdata.image.filename %>">
                </div>
            </div>
            <div class="show-details">
                <div class="card-body px-0">
                    <h5 class="card-text mb-2">
                        Owned by: <i><%= listingdata.owner && listingdata.owner.username ? listingdata.owner.username : "Unknown" %></i>
                    </h5>
                    <h5 class="card-text mb-3"><%= listingdata.description %></h5>
                    <h5 class="card-text mb-1">&#8377; <%= listingdata.price %></h5>
                    <h5 class="card-text mb-1"><%= listingdata.location %></h5>
                    <h5 class="card-text"><%= listingdata.country %></h5>
                </div>
            </div>

            <% if (currUser && listingdata.owner._id.equals(currUser._id)) { %>
                <div class="btns gap-2 mt-3">
                    <a href="/listings/<%= listingdata._id %>/edit" class="btn edit-btn">Edit</a>
                    <form method="post" action="/listings/<%= listingdata._id %>?_method=DELETE">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            <% } %>

            <% if (currUser) { %>
                <div class="mt-4">
                    <hr>
                    <h4>Leave a Review</h4>
                    <form method="post" action="/listings/<%= listingdata._id %>/reviews" class="needs-validation" novalidate>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                        <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Comments</label>
                            <textarea name="review[comments]" rows="5" required id="comment" cols="30" class="form-control"></textarea>
                            <div class="invalid-feedback">
                                please submit comment for review
                            </div>
                            <div class="valid-feedback">
                                Looks good
                            </div><br>
                            <button class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            <% } %>

            <% if (listingdata.reviews && listingdata.reviews.length > 0) { %>
                <div class="reviews-card mt-4">
                    <h4 class="reviews-title">All Reviews</h4>

                    <ul class="reviews-list flexible">
                        <% for (review of listingdata.reviews) { %>
                            <li class="review-item">
                                <div class="review-main">
                                    <div class="review-author"><%= review.author && review.author.username ? review.author.username.charAt(0) : '?' %></div>
                                    <div class="review-body">
                                        <div class="review-username">@<%= review.author && review.author.username ? review.author.username : 'Unknown' %></div>
                                        <div class="review-comment"><%= review.comments %></div>
                                    </div>
                                </div>
                                <div class="review-actions">
                                    <span class="review-rating"><%= review.rating %> &#11088;</span>
                                    <form action="/listings/<%= listingdata._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                                        <button class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </div>
                            </li>
                        <% } %>
                    </ul>
                </div>
            <% } %>
        </div>
    </div>